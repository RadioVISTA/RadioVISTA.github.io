{
  "name": "radiovista-website",
  "private": true,
  "version": "0.1.0",
  "description": "RadioVISTA project website (radiovista.github.io)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "data:results": "node scripts/extract-results.mjs",
    "data:figs": "python scripts/convert-figs.py",
    "data:thumbs": "python scripts/assets/make-thumbs.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
